# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.

# ----------------------------------------------------
# BACKEND (Railway / Docker / Local)
# ----------------------------------------------------

# PostgreSQL (Option A: Direct URL, standard on Railway)
DATABASE_URL=postgresql://prism_user:change_me@postgres:5432/prism_db

# PostgreSQL (Option B: Individual components)
POSTGRES_USER=prism_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=prism_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Neo4j Graph Database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# Redis (Celery Broker & Cache)
REDIS_URL=redis://redis:6379/0

# MinIO / S3 Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me

# Backend CORS Allowed Origins (comma-separated)
CORS_ORIGINS=https://prism-dashboard.web.app,https://prism-dashboard.firebaseapp.com,http://localhost:3000

# ----------------------------------------------------
# FRONTEND (Firebase / Vercel / Local)
# ----------------------------------------------------
NEXT_PUBLIC_API_URL=https://prism-production-fd7b.up.railway.app

